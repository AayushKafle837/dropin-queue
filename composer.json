{
    "name": "aayushkafle/dropin-queue",
    "description": "A drop-in help queue for peer learning sessions, built in plain PHP 8 with a small hand-rolled MVC layer.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox",
        "serve": "php -S localhost:8000 -t public"
    }
}
